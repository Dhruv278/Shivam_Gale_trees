# The absolute base URL that QR codes encode.
#
# Set this to the FINAL production domain before generating QR codes for printing.
# Every generated code embeds this value, so changing the domain afterwards
# invalidates every printed code and forces a full reprint.
#
# Leave unset locally to fall back to window.location.origin (the portal will warn).
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
