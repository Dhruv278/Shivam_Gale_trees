# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Operator's raw drop folder. These are copied into public/images/, which is the
# folder the app actually reads, so committing both would double the repo size.
/Sample_images/

# Raw Google Drive exports. The images get extracted into public/images/; keeping
# the archive too would store every image twice.
/drive-download-*.zip

# Reference photos sent over WhatsApp; the usable copies live in public/plates/.
/WhatsApp Image *.jpeg

# Production print files written by scripts/generate-print-files.mjs.
/output/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
